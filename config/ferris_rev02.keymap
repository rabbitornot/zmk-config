#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include "french.h"

&lt {
    quick-tap-ms = <200>;
    flavor = "hold-preferred";
};

/ {
    behaviors {
        tacl: toaccentslayer {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sl 1>, <&kp FR_EXLM>;
            mods = <(MOD_RSFT)>;
            keep-mods = <(MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };
        mint: minusinterrogation {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp FR_MINS>, <&kp FR_QUES>;
            mods = <(MOD_RSFT)>;
            keep-mods = <(MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };
        dtn: dotcoln {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp FR_DOT>, <&kp FR_COLN>;
            mods = <(MOD_RSFT)>;
            keep-mods = <(MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };
        csm: commasemicolon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp FR_COMM>, <&kp FR_SCLN>;
            mods = <(MOD_RSFT)>;
            keep-mods = <(MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;

            tapping-term-ms = <220>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;

            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        a_circ: a_circ {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <0>;
			tap-ms = <0>;
			bindings= <&macro_tap &kp FR_CIRC &kp FR_A>;
		};
        u_circ: u_circ {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <0>;
			tap-ms = <0>;
			bindings = <&macro_tap &kp FR_CIRC &kp FR_U>;
		};
        tild: tilde {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <0>;
			tap-ms = <0>;
			bindings = <&macro_tap &kp FR_TILD &kp SPACE>;
		};
        circo: circonflexe {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <0>;
			tap-ms = <0>;
			bindings = <&macro_tap &kp FR_CIRC &kp SPACE>;
		};
        
        grv: grave {
        	compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <0>;
			tap-ms = <0>;
			bindings = <&macro_tap &kp FR_GRV &kp SPACE>;
		};
    };

    

    keymap {    
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
	        &kp FR_Q &kp FR_C      &kp FR_O      &kp FR_P       &kp FR_W            &kp FR_J &kp FR_M       &kp FR_D      &tacl         &kp FR_Y 
	        &kp FR_A &hm LALT FR_S &hm RGUI FR_E &hm RCTRL FR_N &kp FR_F            &kp FR_L &hm RCTRL FR_R &hm RGUI FR_T &hm LALT FR_I &kp FR_U
	        &kp FR_Z &kp FR_X      &mint         &kp FR_V       &kp FR_B            &dtn     &kp FR_H       &kp FR_G      &csm        &kp FR_K
                                           &mt RSHIFT ESCAPE   &lt 3 BACKSPACE    &lt 3 SPACE  &lt 2 ENTER
			>;
        };

        accents {

            bindings = <
            &a_circ      &kp FR_CCED &kp FR_OE    &kp FR_OCIRC    &none       &none &none &none        &none        &u_circ
            &kp FR_AGRV  &kp FR_EACU &kp FR_EGRV  &kp FR_ECIRC    &none       &none &none &kp FR_ICIRC &kp FR_ITREM &kp FR_UGRV
            &kp FR_AE    &none       &none        &none           &none       &none &none &none        &none        &none 
                                                  &none &none &none &none     
            >;
        };

        symbols {
            bindings = <
            &circo       &kp FR_LABK &kp FR_RABK &kp FR_DLR  &kp FR_PERC     &kp FR_AT   &kp FR_AMPR &kp FR_ASTR &kp FR_QUOT &grv
            &kp FR_LCBR  &kp FR_LPRN &kp FR_RPRN &kp FR_RCBR &kp FR_EQL      &kp FR_BSLS &kp FR_PLUS &kp FR_MINS &kp FR_SLSH &kp FR_DQUO
            &tild        &kp FR_LBRC &kp FR_RBRC &kp FR_UNDS &kp FR_HASH     &kp FR_PIPE &kp FR_EXLM &kp FR_SCLN &kp FR_COLN &kp FR_QUES 
                                                 &none &none                 &none &none 
            >;
        };

        navigate {
            bindings = <
&kp TAB        &kp PAGE_DOWN        &kp PAGE_UP  &none                  &kp END                 &mkp RCLK &kp FR_7  &kp FR_8  &kp FR_9  &kp CAPSLOCK
&kp LEFT       &kp DOWN          &kp UP       &kp RIGHT              &kp HOME                &mkp LCLK &kp FR_4  &kp FR_5  &kp FR_6  &kp FR_0
&mmv MOVE_LEFT &mmv MOVE_DOWN    &mmv MOVE_UP &mmv MOVE_RIGHT        &none                   &none     &kp FR_1  &kp FR_2  &kp FR_3  &kp FR_DOT
                                                                     &none    &none          &none       &none
            >;
        };
    };
};
